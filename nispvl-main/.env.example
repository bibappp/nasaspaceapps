# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- NASA Earthdata (нужен только для SMAP; без него влажность берётся из NASA POWER) ---
# Аккаунт: https://urs.earthdata.nasa.gov  ->  Profile -> Generate Token
EARTHDATA_TOKEN=
# Альтернатива токену (нужен пакет earthaccess: pip install -e "backend[earthdata]")
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Режим без сети: только data/demo и data/cache, ни одного внешнего запроса ---
OFFLINE=0

# --- Необязательно ---
# Свой набор корневых сертификатов (корпоративный прокси)
CA_BUNDLE=
# Адреса фронтенда, которым разрешён доступ к API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Учётные записи ---
# Путь к базе SQLite (по умолчанию DATA_DIR/app.db; в Docker это ./data/app.db на хосте)
DB_PATH=
# Срок жизни сессии, дней
SESSION_DAYS=30
# 1 — cookie сессии только по HTTPS (включите за TLS-прокси в продакшене)
COOKIE_SECURE=0
# 0 — запретить новые регистрации
ALLOW_REGISTRATION=1
# Через сколько дней удаляются демо-песочницы
DEMO_TTL_DAYS=3
